---js
const eleventyNavigation = {
	key: "Resume",
	order: 4
};
---
<section id="resume">
    <h1>Resume</h1>
    <div class="resume-section">
        <h2>About</h2>
        <div class="about">
            <p><b>Name: </b>{{ resume.about.name }}</p>
            <p><b>Title: </b>{{ resume.about.label }}</p>
            <p><b>Location: </b>{{ resume.about.location.city }} - {{ resume.about.location.countryCode }}</p>
            <p><b>About: </b>{{ resume.about.summary }}</p>
            <p><b>Links: </b></p>
            <p class="resume-links"><a href="{{ resume.about.profiles.linkedin }}">{{ resume.about.profiles.linkedin }}</a></p>
            <p class="resume-links"><a href="{{ resume.about.profiles.github }}">{{ resume.about.profiles.github }}</a></p>
        </div>
    </div>
    <hr>
    <div class="resume-section">
        <h2>Experience</h2>
        {% for job in resume.experience %}
            <div class="job">
                <h3>{{ job.position }}</h3>
                <p><b>Company: </b>{{ job.company }} - {{ job.location }}</p>
                <p><i>{{ job.startDate }} - {{ job.endDate }}</i></p>
                <p><b>Summary: </b></p>
                <ul class="job-summary">
                {% for highlight in job.highlights %}
                    <p>{{ highlight }}</p>
                {% endfor %}
                </ul>
            </div>
        {% endfor %}
    </div>
    <hr>
    <div class="resume-section">
        <h2>Education</h2>
        {% for education in resume.education %}
            <div class="education">
                <h3>{{ education.studyTypeShort }}</h3>
                <p><b>Institution: </b>{{ education.institution }} - {{ education.location }}</p>
                <p><i>{{ education.startDate }} - {{ education.endDate }}</i></p>
                <p><b>Major: </b>{{ education.description }}</p>
            </div>
        {% endfor %}
    </div>
    <hr>
    <div class="resume-section">
        <h2>Skills</h2>
        <ul>
            {% for skill in resume.skills %}
                <li>{{ skill.name }} - {{ skill.experience }}</li>
            {% endfor %}
        </ul>
    </div>
</section>